        {
          "name": "3. PATCH Update Comment (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Текст комментария обновлён', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.text).to.equal('Обновлённый текст комментария.');",
                  "});",
                  "",
                  "pm.test('ID комментария совпадает', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.equal(Number(pm.collectionVariables.get('commentId')));",
                  "});"
