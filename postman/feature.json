    {
      "name": "2. Comment Tests",
      "item": [
        {
          "name": "1. POST Create Comment (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Ответ содержит ID комментария', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.collectionVariables.set('commentId', json.id);",
                  "});",
                  "",
                  "pm.test('Текст совпадает с отправленным', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.text).to.equal('Это мой первый комментарий к событию!');",
                  "});",
                  "",
                  "pm.test('Ответ содержит поле author', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('author');",
                  "  pm.expect(json.author).to.have.property('id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sharer-User-Id",
                "value": "{{userId1}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Это мой первый комментарий к событию!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "comments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. GET Comments (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Ответ является массивом', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Массив содержит хотя бы один элемент', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Первый элемент имеет поля id, text, author', () => {",
                  "  const first = pm.response.json()[0];",
                  "  pm.expect(first).to.have.property('id');",
                  "  pm.expect(first).to.have.property('text');",
                  "  pm.expect(first).to.have.property('author');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "comments"
              ]
            }
          },
          "response": []
